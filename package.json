{
  "name": "@cospired/javascript",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A slightly opinionated approach to JavaScript and TypeScript.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present && node --test test-utils/*.test.js scripts/*.test.js",
    "lint": "eslint .",
    "changeset": "changeset",
    "release": "changeset publish",
    "rules": "node scripts/rule-table.js",
    "smoke": "node scripts/smoke-pack.js",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cospired/javascript.git"
  },
  "contributors": [
    {
      "name": "Dirk Haage",
      "email": "dirk@cospired.com",
      "url": "https://cospired.com/"
    },
    {
      "name": "Jan Schmidle",
      "email": "jan@cospired.com",
      "url": "https://cospired.com/"
    }
  ],
  "author": "Dirk Haage <dirk@cospired.com>",
  "license": "BSD-3-Clause-Clear",
  "bugs": {
    "url": "https://github.com/cospired/javascript/issues"
  },
  "homepage": "https://github.com/cospired/javascript#readme",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-formatjs": "^8.1.4",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-todo-plz": "^1.4.1",
    "espree": "^11.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
