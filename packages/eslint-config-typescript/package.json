{
  "name": "@cospired/eslint-config-typescript",
  "version": "7.0.0",
  "description": "Slightly opinionated ESLint flat config for TypeScript (type-aware)",
  "type": "module",
  "files": [
    "src"
  ],
  "license": "BSD-3-Clause-Clear",
  "author": "Dirk Haage <dirk@cospired.com>",
  "keywords": [
    "eslint",
    "eslintconfig",
    "flat-config",
    "cospired"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
