{
  "@stylistic/padding-line-between-statements": "kept: blank line before return and after declarations; hapi scope-start dropped (Prettier strips block-leading blank lines)",
  "no-unused-vars": "error, `_` prefix ignored",
  "@typescript-eslint/no-unused-vars": "error, `_` prefix ignored",
  "import-x/order": "always + alphabetize",
  "no-console": "error, allow warn/error; scripts/** exempt",
  "no-unused-expressions": "strict, no React relaxations",
  "object-shorthand": "kept",
  "prefer-arrow-callback": "kept",
  "prefer-const": "kept",
  "no-var": "kept",
  "prefer-object-has-own": "kept",
  "logical-assignment-operators": "kept (incl. if statements)",
  "import-x/no-duplicates": "kept",
  "import-x/no-relative-packages": "kept",
  "import-x/no-import-module-exports": "kept",
  "import-x/no-empty-named-blocks": "kept",
  "import-x/newline-after-import": "kept",
  "import-x/consistent-type-specifier-style": "kept: prefer-inline",
  "@eslint-community/eslint-comments/disable-enable-pair": "kept",
  "@eslint-community/eslint-comments/no-aggregating-enable": "kept",
  "@eslint-community/eslint-comments/no-duplicate-disable": "kept",
  "@eslint-community/eslint-comments/no-unlimited-disable": "kept",
  "@eslint-community/eslint-comments/no-unused-enable": "kept",
  "@eslint-community/eslint-comments/require-description": "kept",
  "import-x/no-extraneous-dependencies": "kept (eventured globs, overridable)",
  "todo-plz/ticket-ref": "kept",
  "eqeqeq": "adopted, `== null` allowed",
  "no-param-reassign": "adopted, props: false",
  "consistent-return": "adopted, JS only",
  "no-shadow": "adopted (TS: typescript-eslint version)",
  "@typescript-eslint/no-shadow": "adopted",
  "prefer-template": "adopted",
  "no-nested-ternary": "adopted",
  "no-else-return": "adopted, allowElseIf: false",
  "curly": "adopted, multi-line (re-enabled after Prettier)",
  "no-use-before-define": "adopted, strict",
  "@typescript-eslint/no-use-before-define": "adopted, strict",
  "default-param-last": "adopted",
  "@typescript-eslint/default-param-last": "adopted",
  "no-await-in-loop": "adopted",
  "@typescript-eslint/explicit-function-return-type": "default on for non-test files, allowExpressions",
  "@typescript-eslint/no-misused-promises": "default on, flagUnions strict",
  "@typescript-eslint/no-generated-empty-object-type": "default on",
  "@typescript-eslint/no-explicit-any": "error (no warn policy)",
  "react-refresh/only-export-components": "error (no warn policy)",
  "formatjs/enforce-description": "off (eventured)",
  "formatjs/no-camel-case": "error (eventured)",
  "formatjs/no-invalid-icu": "error (eventured)",
  "formatjs/no-literal-string-in-jsx": "error (no warn policy)",
  "react-hooks/exhaustive-deps": "error (no warn policy)",
  "react-hooks/incompatible-library": "error (no warn policy)",
  "react-hooks/unsupported-syntax": "error (no warn policy)"
}
